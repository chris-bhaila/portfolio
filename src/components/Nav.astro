---
const links = [
  { label: 'Work', href: '#work' },
  { label: 'About', href: '#about' },
  { label: 'Contact', href: '#contact' },
]
---

<header class="bg-dark border-b border-white/[0.08] sticky top-0 z-50">
  <nav class="max-w-6xl mx-auto px-8 py-[18px] flex items-center justify-between">

    <a href="/" class="font-mono text-sm font-medium text-white tracking-tight">
      chrisbhaila<span class="text-accent">®</span>
    </a>

    <ul class="hidden md:flex items-center gap-8 list-none m-0 p-0">
      {links.map(link => (
        <li>
          <a
            href={link.href}
            class="text-white/40 text-sm tracking-wide hover:text-white transition-colors duration-200"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <a
      href="#contact"
      class="bg-white text-dark text-xs font-medium px-5 py-2 rounded-full hover:bg-cream transition-colors duration-200"
    >
      Hire me
    </a>

  </nav>
</header>