---
import Icon from './Icon.astro'

const links = [
  { label: 'Work', href: '#work' },
  { label: 'About', href: '#about' },
  { label: 'Skills', href: '#stack' },
  { label: 'Resume', href: '/files/Chris_Bhaila_Resume.pdf', external: true },
]
---

<header class="bg-bg/90 backdrop-blur-sm sticky top-0 z-50 border-b border-border">
  <nav class="max-w-6xl mx-auto px-6 sm:px-8 py-4 flex items-center justify-between">

    <a href="/" class="font-display font-bold text-lg tracking-tight text-ink transition-transform duration-300 hover:-rotate-3 hover:scale-110 inline-block">
      CB
    </a>

    <ul class="hidden md:flex items-center gap-8 list-none m-0 p-0">
      {links.map(link => (
        <li>
          <a
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
            class="relative text-muted text-sm font-medium hover:text-ink transition-colors duration-200 after:content-[''] after:absolute after:left-0 after:-bottom-1 after:h-px after:w-0 after:bg-accent after:transition-[width] after:duration-300 after:ease-out hover:after:w-full"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-3">
      <button
        id="theme-toggle"
        class="text-muted hover:text-ink p-2 -m-2 rounded-full transition-all duration-200 hover:bg-ink/5 active:scale-90"
        aria-label="Toggle dark mode"
      >
        <Icon name="sun" class="w-[18px] h-[18px] hidden dark:block" />
        <Icon name="moon" class="w-[18px] h-[18px] block dark:hidden" />
      </button>
      <a
        href="#contact"
        class="group hidden sm:inline-flex items-center gap-1.5 bg-ink text-bg text-sm font-medium rounded-full px-5 py-2 transition-all duration-200 hover:bg-accent hover:scale-105 active:scale-95"
      >
        Let's Connect
        <Icon name="arrow-up-right" class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
      </a>
      <button
        id="menu-toggle"
        class="md:hidden text-ink p-1 transition-transform duration-200 active:scale-90"
        aria-label="Toggle menu"
      >
        <svg id="menu-icon" class="w-5 h-5 transition-all duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="w-5 h-5 hidden transition-all duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

  </nav>

  <div id="mobile-menu" class="md:hidden">
    <ul class="list-none m-0 p-0 px-6 py-5 flex flex-col gap-5">
      {links.map(link => (
        <li>
          <a
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
            class="text-muted text-sm font-medium hover:text-ink hover:translate-x-1 transition-all duration-200 block"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  function initNav() {
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const menuIcon = document.getElementById('menu-icon');
    const closeIcon = document.getElementById('close-icon');

    const closeMenu = () => {
      menu?.classList.remove('menu-open');
      menuIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    };

    toggle?.addEventListener('click', () => {
      menu?.classList.toggle('menu-open');
      menuIcon?.classList.toggle('hidden');
      closeIcon?.classList.toggle('hidden');
    });

    menu?.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', closeMenu);
    });

    const themeToggle = document.getElementById('theme-toggle');
    themeToggle?.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });
  }

  document.addEventListener('astro:page-load', initNav);
</script>
