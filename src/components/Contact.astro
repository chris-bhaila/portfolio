---
import Icon from './Icon.astro'

const links = [
  { icon: 'mail', label: 'chrisbhaila5@gmail.com', href: 'mailto:chrisbhaila5@gmail.com' },
  { icon: 'pin', label: 'Kathmandu, Nepal', href: null },
  { icon: 'github', label: 'github.com/chris-bhaila', href: 'https://github.com/chris-bhaila' },
  { icon: 'linkedin', label: 'linkedin.com/in/chris-bhaila', href: 'https://www.linkedin.com/in/chris-bhaila-b53a65271/' },
]
---

<section id="contact" class="relative px-6 sm:px-8 py-20 overflow-hidden">
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_70%_55%_at_20%_100%,rgba(109,94,240,0.12),transparent)]"></div>
  <div class="max-w-6xl mx-auto">

    <div class="flex items-center gap-2 mb-4 reveal">
      <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
      <p class="font-mono text-accent text-xs font-semibold uppercase tracking-wide">Get In Touch</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-[1fr_auto] gap-8 items-start mb-10 reveal">
      <h2 class="font-display font-bold text-[clamp(1.8rem,4vw,2.75rem)] leading-[1.1] tracking-[-0.02em] text-ink max-w-xl">
        Let's build something intelligent together.
      </h2>
      <div class="flex flex-col gap-4 md:items-end">
        <p class="text-muted text-sm leading-relaxed max-w-xs md:text-right">
          I'm always open to discussing new projects, creative ideas, or
          opportunities to be part of your visions.
        </p>
        <a
          href="mailto:chrisbhaila5@gmail.com"
          class="group inline-flex items-center gap-2 bg-ink text-bg text-sm font-medium rounded-full px-6 py-3 transition-all duration-200 hover:bg-accent hover:scale-105 active:scale-95"
        >
          Let's Connect
          <Icon name="arrow-up-right" class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
        </a>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 reveal">
      {links.map((item) => (
        item.href ? (
          <a
            href={item.href}
            target={item.href.startsWith('http') ? '_blank' : undefined}
            rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            class="flex items-center gap-3 bg-surface border border-border rounded-xl px-5 py-3.5 text-ink hover:border-ink/25 hover:-translate-y-0.5 hover:shadow-[0_8px_20px_rgba(0,0,0,0.05)] dark:hover:shadow-[0_8px_20px_rgba(139,127,255,0.1)] active:scale-[0.98] active:translate-y-0 transition-all duration-200 group"
          >
            <Icon name={item.icon} class="w-4 h-4 text-muted shrink-0" />
            <span class="text-sm flex-1 truncate">{item.label}</span>
            <Icon name="arrow-up-right" class="w-3.5 h-3.5 text-muted-2 group-hover:text-ink transition-colors duration-200 shrink-0" />
          </a>
        ) : (
          <div class="flex items-center gap-3 bg-surface border border-border rounded-xl px-5 py-3.5 text-ink">
            <Icon name={item.icon} class="w-4 h-4 text-muted shrink-0" />
            <span class="text-sm flex-1">{item.label}</span>
          </div>
        )
      ))}
    </div>

  </div>
</section>

<footer class="border-t border-border px-6 sm:px-8 py-6">
  <div class="max-w-6xl mx-auto flex flex-wrap items-center justify-between gap-2">
    <span class="text-muted-2 text-xs">© 2026 Chris Bhaila. All rights reserved.</span>
    <span class="text-muted-2 text-xs flex items-center gap-1.5">
      Built with passion. Always learning.
      <span class="w-1 h-1 rounded-full bg-accent inline-block"></span>
    </span>
  </div>
</footer>
