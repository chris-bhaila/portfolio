---

---

<section id="contact" class="bg-dark px-6 sm:px-8 pt-24 pb-0">
  <form
    action="https://formspree.io/f/xjgdzyyq"
    method="POST"
    id="contact-form"
  >
    <div
      class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 items-stretch pb-12"
    >
      <div class="flex flex-col justify-between h-full">
        <div>
          <p
            class="font-mono text-[11px] text-white/35 tracking-[0.1em] uppercase mb-4"
          >
            — get in touch
          </p>
          <h2
            class="font-serif text-[clamp(1.6rem,3vw,2.5rem)] leading-[1.1] tracking-[-0.02em] text-white mb-4"
          >
            Let's build<br />
            <em class="text-white/40">something useful.</em>
          </h2>
          <p class="text-white/35 text-sm leading-relaxed mb-8">
            Open to full-time roles. Reach out if you're building something that
            needs ML or a solid web foundation.
          </p>
        </div>
        <div class="flex flex-col gap-3">
          <a
            href="mailto:chrisbhaila5@gmail.com"
            class="flex items-center gap-4 bg-white/[0.04] border border-white/10 rounded-none px-5 py-3.5 text-white/60 hover:border-white/20 hover:text-white transition-colors duration-200 group"
          >
            <svg
              class="w-4 h-4 shrink-0"
              viewBox="0 0 24 24"
              fill="currentColor"
              ><path
                d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"
              ></path></svg
            >
            <span class="font-mono text-xs flex-1">Gmail</span>
            <span
              class="group-hover:translate-x-0.5 transition-transform duration-200"
              >→</span
            >
          </a>
          <a
            href="https://github.com/chris-bhaila"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-4 bg-white/[0.04] border border-white/10 rounded-none px-5 py-3.5 text-white/60 hover:border-white/20 hover:text-white transition-colors duration-200 group"
          >
            <svg
              class="w-4 h-4 shrink-0"
              viewBox="0 0 24 24"
              fill="currentColor"
              ><path
                d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"
              ></path></svg
            >
            <span class="font-mono text-xs flex-1">GitHub</span>
            <span
              class="group-hover:translate-x-0.5 transition-transform duration-200"
              >→</span
            >
          </a>
          <a
            href="https://www.linkedin.com/in/chris-bhaila-b53a65271/"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-4 bg-white/[0.04] border border-white/10 rounded-none px-5 py-3.5 text-white/60 hover:border-white/20 hover:text-white transition-colors duration-200 group"
          >
            <svg
              class="w-4 h-4 shrink-0"
              viewBox="0 0 24 24"
              fill="currentColor"
              ><path
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
              ></path></svg
            >
            <span class="font-mono text-xs flex-1">LinkedIn</span>
            <span
              class="group-hover:translate-x-0.5 transition-transform duration-200"
              >→</span
            >
          </a>
        </div>
      </div>
      <div class="flex flex-col gap-4">
        <input
          type="text"
          name="name"
          placeholder="Your name"
          required
          class="w-full bg-white/[0.04] border border-white/10 rounded-none px-5 py-4 text-white/60 font-mono text-xs placeholder:text-white/20 focus:outline-none focus:border-accent/40"
        />
        <input
          type="email"
          name="email"
          placeholder="Your email"
          required
          class="w-full bg-white/[0.04] border border-white/10 rounded-none px-5 py-4 text-white/60 font-mono text-xs placeholder:text-white/20 focus:outline-none focus:border-accent/40"
        />
        <textarea
          name="message"
          placeholder="Leave a message..."
          rows="5"
          required
          class="w-full bg-white/[0.04] border border-white/10 rounded-none px-5 py-4 text-white/60 font-mono text-xs placeholder:text-white/20 focus:outline-none focus:border-accent/40 resize-none flex-1"
        ></textarea>
        <button
          type="submit"
          class="w-full bg-accent text-white font-mono text-xs py-4 rounded-none hover:bg-accent-light transition-colors duration-200 cursor-pointer"
        >
          Send message →
        </button>
      </div>
    </div>
  </form>
</section>

<footer class="bg-dark border-t border-white/[0.06] px-6 sm:px-8 py-5">
  <div class="max-w-6xl mx-auto flex flex-wrap items-center justify-between gap-2">
    <span class="font-mono text-[11px] text-white/15">© 2025 Chris Bhaila</span>
    <span class="font-mono text-[11px] text-white/15"
      >Built with Astro · Tailwind</span
    >
  </div>
</footer>
