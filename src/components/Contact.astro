---
---

<section id="contact" class="bg-dark px-8 pt-24 pb-0">
  <form
    action="https://formspree.io/f/xjgdzyyq"
    method="POST"
    id="contact-form"
  >
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 items-start pb-8">

      <div>
        <p class="font-mono text-[11px] text-white/35 tracking-[0.1em] uppercase mb-5">
          — get in touch
        </p>
        <h2 class="font-serif text-[clamp(1.6rem,3vw,2.5rem)] leading-[1.1] tracking-[-0.02em] text-white mb-4">
          Let's build<br />
          <em class="text-white/40">something useful.</em>
        </h2>
        <p class="text-white/35 text-sm leading-relaxed max-w-sm mb-8">
          Open to full-time roles and freelance projects. If you're building
          something that needs ML under the hood or a solid web foundation,
          reach out.
        </p>
        <div class="flex flex-col gap-3">
          <a href="mailto:chrisbhaila5@email.com" class="flex items-center justify-between bg-white/[0.04] border border-white/10 rounded-xl px-5 py-4 text-white/60 hover:border-white/20 hover:text-white transition-colors duration-200 group">
            <span class="font-mono text-xs">chrisbhaila5@email.com</span>
            <span class="group-hover:translate-x-0.5 transition-transform duration-200">→</span>
          </a>
          <a href="https://github.com/chris-bhaila" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between bg-white/[0.04] border border-white/10 rounded-xl px-5 py-4 text-white/60 hover:border-white/20 hover:text-white transition-colors duration-200 group">
            <span class="font-mono text-xs">github.com/chris-bhaila</span>
            <span class="group-hover:translate-x-0.5 transition-transform duration-200">→</span>
          </a>
          <a href="https://linkedin.com/in/chrisbhaila" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between bg-white/[0.04] border border-white/10 rounded-xl px-5 py-4 text-white/60 hover:border-white/20 hover:text-white transition-colors duration-200 group">
            <span class="font-mono text-xs">linkedin.com/in/chrisbhaila</span>
            <span class="group-hover:translate-x-0.5 transition-transform duration-200">→</span>
          </a>
        </div>
      </div>

      <div class="flex flex-col gap-4">
        <input
          type="text"
          name="name"
          placeholder="Your name"
          required
          class="w-full bg-white/[0.04] border border-white/10 rounded-xl px-5 py-4 text-white/60 font-mono text-xs placeholder:text-white/20 focus:outline-none focus:border-accent/40"
        />
        <input
          type="email"
          name="email"
          placeholder="Your email"
          required
          class="w-full bg-white/[0.04] border border-white/10 rounded-xl px-5 py-4 text-white/60 font-mono text-xs placeholder:text-white/20 focus:outline-none focus:border-accent/40"
        />
        <textarea
          name="message"
          placeholder="What are you building?"
          rows="5"
          required
          class="w-full bg-white/[0.04] border border-white/10 rounded-xl px-5 py-4 text-white/60 font-mono text-xs placeholder:text-white/20 focus:outline-none focus:border-accent/40 resize-none"
        ></textarea>
        <button
          type="submit"
          class="w-full bg-accent text-white font-mono text-xs py-4 rounded-xl hover:bg-accent-light transition-colors duration-200 cursor-pointer"
        >
          Send message →
        </button>
        <p id="form-status" class="font-mono text-[11px] text-center text-white/40 hidden"></p>
      </div>

    </div>
  </form>
</section>

<footer class="bg-dark border-t border-white/[0.06] px-8 py-5">
  <div class="max-w-6xl mx-auto flex items-center justify-between">
    <span class="font-mono text-[11px] text-white/15">© 2025 Chris Bhaila</span>
    <span class="font-mono text-[11px] text-white/15">Built with Astro · Tailwind</span>
  </div>
</footer>