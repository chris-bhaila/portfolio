---
import type { Project } from '../../data/projects'

interface Props {
  project: Project
}

const { project } = Astro.props
---

<section class="bg-dark px-8 py-16">
  <div class="max-w-4xl mx-auto grid grid-cols-1 lg:grid-cols-[180px_1fr] gap-10">

    <div>
      <p class="font-mono text-[10.5px] tracking-[0.12em] uppercase text-white/20 mb-1">
        — Stack
      </p>
    </div>

    <div class="flex flex-wrap gap-2">
      {project.stack.map((tech) => (
        <span class="font-mono text-[11px] tracking-[0.06em] px-3 py-1.5 border border-white/10 text-white/40">
          {tech}
        </span>
      ))}
    </div>

  </div>
</section>