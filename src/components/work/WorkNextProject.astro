---
import type { Project } from '../../data/projects'
import Icon from '../Icon.astro'

interface Props {
  project: Project
}

const { project } = Astro.props
---

<section class="px-6 sm:px-8 py-16 border-t border-border">
  <div class="max-w-4xl mx-auto reveal">
    <a
      href={`/work/${project.slug}`}
      class="group flex items-center justify-between gap-6 p-6 sm:p-8 rounded-2xl border border-border bg-surface transition-all duration-300 hover:-translate-y-1 hover:border-accent/40 hover:shadow-[0_16px_40px_rgba(0,0,0,0.1)] dark:hover:shadow-[0_16px_40px_rgba(139,127,255,0.15)]"
    >
      <div>
        <p class="font-mono text-accent text-xs font-semibold uppercase tracking-wide mb-2">
          Next project
        </p>
        <h3 class="font-display font-bold text-2xl sm:text-3xl text-ink tracking-[-0.02em]">
          {project.title}
        </h3>
        <p class="text-muted text-sm mt-2 max-w-md">
          {project.tagline}
        </p>
      </div>
      <span class="shrink-0 w-11 h-11 rounded-full border border-border flex items-center justify-center text-ink transition-all duration-300 group-hover:bg-ink group-hover:text-bg group-hover:border-ink">
        <Icon name="arrow-up-right" class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
      </span>
    </a>
  </div>
</section>
