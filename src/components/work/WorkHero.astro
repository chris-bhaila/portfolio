---
import type { Project } from "../../data/projects";

interface Props {
    project: Project;
}

const { project } = Astro.props;
---

<section class="bg-dark px-8 pt-24 pb-16 border-b border-white/[0.06]">
    <div class="max-w-4xl mx-auto">
        <div class="flex items-center gap-3 mb-10">
            <a
                href="/#work"
                class="font-mono text-[10.5px] tracking-[0.12em] uppercase text-white/25 hover:text-white/50 transition-colors duration-150"
            >
                ← Work
            </a>
            <span class="text-white/10">/</span>
            <span
                class="font-mono text-[10.5px] tracking-[0.12em] uppercase text-white/25"
            >
                {project.title}
            </span>
        </div>

        <div class="flex items-center gap-3 mb-6">
            <span
                class="font-mono text-[10.5px] tracking-[0.12em] uppercase text-accent/70"
            >
                {project.type}
            </span>
            <span class="w-1 h-1 rounded-full bg-white/15"></span>
            <span
                class="font-mono text-[10.5px] tracking-[0.12em] uppercase text-white/25"
            >
                {project.year}
            </span>
        </div>

        <h1
            class="font-serif text-[clamp(2.4rem,6vw,4rem)] leading-none tracking-[-0.025em] text-white/90 mb-6"
        >
            {project.title}<span class="text-accent">.</span>
        </h1>

        <p class="text-[14px] text-white/40 leading-relaxed max-w-xl mb-10">
            {project.tagline}
        </p>

        <div class="flex items-center gap-3">
            {
                project.live && (
                    <a
                        href={project.live}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex items-center gap-2.5 font-mono text-[11.5px] font-medium tracking-[0.06em] uppercase bg-accent text-dark px-6 py-2.5 hover:opacity-85 transition-opacity duration-150"
                    >
                        <span class="relative flex h-1.5 w-1.5">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-dark opacity-75" />
                            <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-dark" />
                        </span>
                        Live site ↗
                    </a>
                )
            }

            {
                project.github && (
                    <a
                        href={project.github}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex items-center gap-2.5 font-mono text-[11.5px] tracking-[0.06em] uppercase text-white/30 border border-white/10 px-6 py-2.5 hover:text-white/60 hover:border-white/25 transition-colors duration-150"
                    >
                        <svg
                            width="14"
                            height="14"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            aria-hidden="true"
                        >
                            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z" />
                        </svg>
                        GitHub ↗
                    </a>
                )
            }
        </div>
    </div>
</section>
