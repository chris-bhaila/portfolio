---
import type { Project } from '../../data/projects'

interface Props {
  project: Project
}

const { project } = Astro.props
---

<section class="px-6 sm:px-8 py-16 border-t border-border">
  <div class="max-w-4xl mx-auto reveal">
    {project.stat ? (
      <div class="flex flex-col sm:flex-row items-baseline gap-3 sm:gap-6">
        <span class="font-display font-bold text-[clamp(3.5rem,10vw,6rem)] leading-none tracking-[-0.03em] text-accent">
          {project.stat.value}
        </span>
        <span class="text-lg text-muted max-w-sm leading-snug">
          {project.stat.label}
        </span>
      </div>
    ) : project.pullQuote && (
      <blockquote class="border-l-2 border-accent pl-6 sm:pl-8">
        <p class="font-display font-medium italic text-[clamp(1.5rem,3.5vw,2.25rem)] leading-[1.3] tracking-[-0.01em] text-ink">
          "{project.pullQuote}"
        </p>
      </blockquote>
    )}
  </div>
</section>
