---
import { createHash } from 'node:crypto'
import { readFileSync } from 'node:fs'
import { fileURLToPath } from 'node:url'
import type { Project } from '../../data/projects'

interface Props {
  project: Project
}

const { project } = Astro.props

function hashPublicFile(src: string) {
  const path = fileURLToPath(new URL(`../../../public${src}`, import.meta.url))
  return createHash('sha1').update(readFileSync(path)).digest('hex')
}

const allSrcs = [project.image, ...(project.images ?? [])].filter(
  (src): src is string => Boolean(src)
)
const seenHashes = new Set<string>()
const galleryImages = allSrcs.filter((src) => {
  const hash = hashPublicFile(src)
  if (seenHashes.has(hash)) return false
  seenHashes.add(hash)
  return true
})
---

{project.image && (
  <section class="bg-dark px-8 py-16 border-b border-white/[0.06]">
    <div class="max-w-4xl mx-auto">

      {galleryImages.length > 0 && (
        <div class="relative mt-4 reveal work-carousel">
          <div class="overflow-hidden border border-white/[0.06]">
            <div class="flex transition-transform duration-300 ease-out work-carousel-track">
              {galleryImages.map((src) => (
                <div class="w-full flex-shrink-0">
                  <img src={src} alt="" class="w-full block" />
                </div>
              ))}
            </div>
          </div>

          {galleryImages.length > 1 && (
            <>
              <button
                type="button"
                aria-label="Previous image"
                class="work-carousel-prev absolute left-3 top-1/2 -translate-y-1/2 flex items-center justify-center w-9 h-9 bg-dark/70 border border-white/10 text-white/60 hover:text-white hover:border-white/30 transition-colors duration-150 cursor-pointer"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6" /></svg>
              </button>
              <button
                type="button"
                aria-label="Next image"
                class="work-carousel-next absolute right-3 top-1/2 -translate-y-1/2 flex items-center justify-center w-9 h-9 bg-dark/70 border border-white/10 text-white/60 hover:text-white hover:border-white/30 transition-colors duration-150 cursor-pointer"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6" /></svg>
              </button>

              <div class="flex items-center justify-center gap-2 mt-4 work-carousel-dots">
                {galleryImages.map((_, i) => (
                  <button
                    type="button"
                    aria-label={`Go to image ${i + 1}`}
                    data-index={i}
                    class="work-carousel-dot w-1.5 h-1.5 rounded-full bg-white/15 hover:bg-white/40 transition-colors duration-150"
                  />
                ))}
              </div>
            </>
          )}
        </div>
      )}

    </div>
  </section>
)}

<script>
  function initCarousels() {
    document.querySelectorAll<HTMLElement>(".work-carousel").forEach((carousel) => {
      const track = carousel.querySelector<HTMLElement>(".work-carousel-track");
      const slides = track?.children.length ?? 0;
      const prevBtn = carousel.querySelector<HTMLButtonElement>(".work-carousel-prev");
      const nextBtn = carousel.querySelector<HTMLButtonElement>(".work-carousel-next");
      const dots = carousel.querySelectorAll<HTMLButtonElement>(".work-carousel-dot");
      if (!track || slides === 0) return;

      let index = 0;

      const update = () => {
        track.style.transform = `translateX(-${index * 100}%)`;
        dots.forEach((dot, i) =>
          dot.classList.toggle("bg-white/60", i === index)
        );
      };

      prevBtn?.addEventListener("click", () => {
        index = (index - 1 + slides) % slides;
        update();
      });

      nextBtn?.addEventListener("click", () => {
        index = (index + 1) % slides;
        update();
      });

      dots.forEach((dot) => {
        dot.addEventListener("click", () => {
          index = Number(dot.dataset.index);
          update();
        });
      });

      update();
    });
  }

  initCarousels();
</script>
