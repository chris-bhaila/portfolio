---
import type { Project } from '../../data/projects'

interface Props {
  project: Project
}

const { project } = Astro.props
---

{project.image && (
  <section class="bg-dark px-8 py-16 border-b border-white/[0.06]">
    <div class="max-w-4xl mx-auto">

      <div class="overflow-hidden border border-white/[0.06] reveal">
        <img
          src={project.image}
          alt={project.title}
          class="w-full block"
        />
      </div>

      {project.images && project.images.length > 0 && (
        <div class="grid grid-cols-2 gap-4 mt-4">
          {project.images.map((src) => (
            <div class="overflow-hidden border border-white/[0.06] reveal">
              <img src={src} alt="" class="w-full block" />
            </div>
          ))}
        </div>
      )}

    </div>
  </section>
)}
