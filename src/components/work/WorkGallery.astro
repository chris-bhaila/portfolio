---
import type { Project } from '../../data/projects'

interface Props {
  project: Project
}

const { project } = Astro.props
---

{project.image && (
  <section class="px-6 sm:px-8 py-12 border-t border-border">
    <div class="max-w-4xl mx-auto">
      <div class="reveal overflow-hidden rounded-2xl border border-border">
        <img src={project.image} alt={`${project.title} — main interface`} class="w-full block" />
      </div>
    </div>
  </section>
)}
