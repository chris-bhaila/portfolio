---
import type { Project } from '../../data/projects'

interface Props {
  project: Project
}

const { project } = Astro.props
---

<section class="bg-dark px-8 py-16 border-b border-white/[0.06]">
  <div class="max-w-4xl mx-auto grid grid-cols-1 lg:grid-cols-[180px_1fr] gap-10">

    <div>
      <p class="font-mono text-md font-bold tracking-[0.12em] uppercase text-white/20 mb-1">
        — Overview
      </p>
    </div>

    <div class="flex flex-col gap-10">

      <div>
        <p class="font-mono text-sm font-bold tracking-[0.1em] uppercase text-accent/50 mb-3">
          What it is
        </p>
        <p class="text-[14px] text-white/50 leading-relaxed">
          {project.overview}
        </p>
      </div>

      <div>
        <p class="font-mono text-sm font-bold tracking-[0.1em] uppercase text-accent/50 mb-3">
          How I built it
        </p>
        <p class="text-[14px] text-white/50 leading-relaxed">
          {project.approach}
        </p>
      </div>

    </div>

  </div>
</section>