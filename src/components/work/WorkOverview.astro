---
import type { Project } from '../../data/projects'

interface Props {
  project: Project
}

const { project } = Astro.props
---

<section class="px-6 sm:px-8 py-12 border-t border-border">
  <div class="max-w-4xl mx-auto grid grid-cols-1 lg:grid-cols-[180px_1fr] gap-10">

    <div>
      <p class="text-muted-2 text-xs font-medium uppercase tracking-wide">
        Overview
      </p>
    </div>

    <div class="flex flex-col gap-10">

      <div>
        <p class="text-accent text-xs font-semibold uppercase tracking-wide mb-3">
          What it is
        </p>
        <p class="text-[15px] text-muted leading-relaxed">
          {project.overview}
        </p>
      </div>

      <div>
        <p class="text-accent text-xs font-semibold uppercase tracking-wide mb-3">
          How I built it
        </p>
        <p class="text-[15px] text-muted leading-relaxed">
          {project.approach}
        </p>
      </div>

    </div>

  </div>
</section>
