---
import type { Project } from '../../data/projects'

interface Props {
  project: Project
}

const { project } = Astro.props
---

<section class="px-6 sm:px-8 py-12 border-t border-border">
  <div class="max-w-4xl mx-auto grid grid-cols-1 lg:grid-cols-[180px_1fr] gap-10">

    <div>
      <p class="text-muted-2 text-xs font-medium uppercase tracking-wide">
        Impact
      </p>
    </div>

    <ul class="flex flex-col gap-4">
      {project.impact.map((item) => (
        <li class="flex items-start gap-4">
          <span class="w-px h-4 bg-accent/50 mt-1.5 flex-shrink-0"></span>
          <p class="text-[15px] text-muted leading-relaxed">{item}</p>
        </li>
      ))}
    </ul>

  </div>
</section>
