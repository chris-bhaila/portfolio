---
import type { Project } from '../../data/projects'

interface Props {
  project: Project
}

const { project } = Astro.props
---

<section class="bg-dark px-8 py-16 border-b border-white/[0.06]">
  <div class="max-w-4xl mx-auto grid grid-cols-1 lg:grid-cols-[180px_1fr] gap-10">

    <div>
      <p class="font-mono text-[10.5px] tracking-[0.12em] uppercase text-white/20 mb-1">
        — Impact
      </p>
    </div>

    <ul class="flex flex-col gap-4">
      {project.impact.map((item) => (
        <li class="flex items-start gap-4">
          <span class="w-px h-4 bg-accent/40 mt-1 flex-shrink-0"></span>
          <p class="text-[14px] text-white/50 leading-relaxed">{item}</p>
        </li>
      ))}
    </ul>

  </div>
</section>