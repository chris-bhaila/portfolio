---
---

<section class="bg-surface border-y border-border px-6 sm:px-8 py-20">
  <div class="max-w-6xl mx-auto">

    <div class="flex items-center gap-2 mb-8 reveal">
      <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
      <p class="font-mono text-accent text-xs font-semibold uppercase tracking-wide">Education</p>
    </div>

    <div class="flex flex-col">

      <div class="grid grid-cols-1 sm:grid-cols-[140px_28px_1fr] gap-2 sm:gap-6 py-7 border-b border-border reveal" style="--reveal-delay: 0ms">
        <p class="font-mono text-muted-2 text-xs font-medium uppercase tracking-wide pt-0.5">2021 — Present</p>
        <div class="hidden sm:flex flex-col items-center h-full">
          <span class="relative flex h-3 w-3 mt-1 shrink-0">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent opacity-75"></span>
            <span class="relative inline-flex rounded-full h-3 w-3 bg-accent"></span>
          </span>
          <span class="w-px flex-1 bg-border mt-2"></span>
        </div>
        <div>
          <h3 class="font-display font-semibold text-lg text-ink mb-1">Bachelor's in Computer Application</h3>
          <p class="text-muted text-sm mb-1 italic">Affiliated to Tribhuwan University</p>
          <p class="text-muted text-sm mb-4">Thames International College, Old Baneshwor, Kathmandu</p>
          <div class="flex flex-wrap gap-1.5">
            {['Data Structures & Algorithms', 'Artificial Intelligence', 'Probability & Statistics', 'Web Technology', 'OOP', 'Numerical Methods', 'Operations Research',
              'DBMS'
            ].map(course => (
              <span class="font-mono text-[11px] px-2.5 py-1 rounded-full border text-muted border-border transition-colors duration-200 hover:border-accent/40 hover:text-accent">
                {course}
              </span>
            ))}
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-[140px_28px_1fr] gap-2 sm:gap-6 py-7 border-b border-border reveal" style="--reveal-delay: 80ms">
        <p class="font-mono text-muted-2 text-xs font-medium uppercase tracking-wide pt-0.5">2019 — 2021</p>
        <div class="hidden sm:flex flex-col items-center h-full">
          <span class="h-3 w-3 rounded-full bg-accent/40 mt-1 shrink-0"></span>
        </div>
        <div>
          <h3 class="font-display font-semibold text-lg text-ink mb-1">+2 Management with Computer Science | GPA:3.38</h3>
          <p class="text-muted text-sm mb-4">Little Angels' College of Management, Hattiban, Lalitpur</p>
          <div class="flex flex-wrap gap-1.5">
            <span class="font-mono text-[11px] px-2.5 py-1 rounded-full border text-muted border-border transition-colors duration-200 hover:border-accent/40 hover:text-accent">C Programming</span>
            <span class="font-mono text-[11px] px-2.5 py-1 rounded-full border text-muted border-border transition-colors duration-200 hover:border-accent/40 hover:text-accent">Calculus</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
