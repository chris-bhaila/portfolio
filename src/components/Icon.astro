---

{filled[name] && (
  <svg class={className} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d={filled[name]} />
  </svg>
)}

{stroke[name] && (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    {stroke[name].split('|').map((seg) =>
      seg.startsWith('circle:') ? (
        (() => {
          const [cx, cy, r] = seg.replace('circle:', '').split(',')
          return <circle cx={cx} cy={cy} r={r} />
        })()
      ) : (
        <path d={seg} />
      )
    )}
  </svg>
)}
