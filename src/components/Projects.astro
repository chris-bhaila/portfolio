---
import { projects } from "../data/projects";
import Icon from './Icon.astro'

const byCategoryOrder = (a: typeof projects[number], b: typeof projects[number]) => b.category_order - a.category_order;
const mlProjects = projects.filter((p) => p.category === 'AI/ML').sort(byCategoryOrder);
const fullstackProjects = projects.filter((p) => p.category === 'Fullstack').sort(byCategoryOrder);

const groups = [
  {
    id: 'work',
    eyebrow: 'Featured Work',
    heading: 'AI/ML Projects',
    linkLabel: 'Explore all projects',
    linkHref: 'https://github.com/chris-bhaila',
    items: mlProjects,
  },
  {
    eyebrow: null,
    heading: 'Fullstack Projects',
    linkLabel: 'View more on GitHub',
    linkHref: 'https://github.com/chris-bhaila',
    items: fullstackProjects,
  },
];
---

<div class="px-6 sm:px-8 pt-16 pb-8">
  <div class="max-w-6xl mx-auto">
    {groups.map((group, gi) => (
      <section id={group.id} class={gi === 0 ? 'mb-16' : 'mb-4'}>
        {group.eyebrow && (
          <div class="flex items-center gap-2 mb-2 reveal">
            <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
            <p class="font-mono text-accent text-xs font-semibold uppercase tracking-wide">{group.eyebrow}</p>
          </div>
        )}
        <div class="flex items-baseline justify-between mb-8 reveal">
          <h2 class="font-display font-bold text-2xl sm:text-3xl tracking-[-0.02em] text-ink">{group.heading}</h2>
          <a href={group.linkHref} target="_blank" rel="noopener noreferrer" class="group hidden sm:inline-flex items-center gap-1.5 text-sm text-muted hover:text-ink transition-colors duration-200">
            {group.linkLabel}
            <Icon name="arrow-up-right" class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {group.items.map((project, pi) => (
            <a
              href={`/work/${project.slug}`}
              class="bg-surface rounded-2xl overflow-hidden flex flex-col reveal group cursor-pointer shadow-[0_1px_2px_rgba(0,0,0,0.04)] dark:shadow-none hover:-translate-y-1 hover:shadow-[0_16px_40px_rgba(0,0,0,0.1)] dark:hover:shadow-[0_16px_40px_rgba(139,127,255,0.15)] transition-all duration-300"
              style={`--reveal-delay: ${(pi % 2) * 100}ms`}
            >
              <div class="relative overflow-hidden bg-dark h-56 sm:h-64">
                {project.image && (
                  <img
                    src={project.image}
                    alt={project.title}
                    class="w-full h-full object-cover object-top group-hover:scale-[1.05] transition-transform duration-500"
                  />
                )}

                <div class="absolute inset-0 bg-dark/0 group-hover:bg-dark/40 transition-colors duration-300"></div>

                <div class="absolute inset-0 flex items-center justify-center opacity-0 scale-90 group-hover:opacity-100 group-hover:scale-100 transition-all duration-300">
                  <span class="w-12 h-12 rounded-full bg-white flex items-center justify-center text-[#0B0B0C] shadow-lg">
                    <Icon name="arrow-up-right" class="w-5 h-5" />
                  </span>
                </div>

                <span class="font-mono absolute top-3 left-3 bg-dark/80 backdrop-blur-sm text-white/80 text-[11px] px-2.5 py-1 rounded-full">
                  {project.stack.slice(0, 3).join(' • ')}
                </span>

                {project.live && (
                  <div class="font-mono absolute top-3 right-3 flex items-center gap-1.5 bg-dark/80 backdrop-blur-sm text-[11px] text-white/80 px-2.5 py-1 rounded-full">
                    <span class="relative flex h-1.5 w-1.5">
                      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-good opacity-75"></span>
                      <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-good"></span>
                    </span>
                    live
                  </div>
                )}

              </div>

              <div class="px-5 py-5 flex flex-col flex-1">
                <h3 class="font-display font-semibold text-lg text-ink mb-1.5">{project.title}</h3>
                <p class="text-muted text-sm leading-relaxed flex-1">
                  {project.tagline}
                </p>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</div>
