---
const projects = [
  {
    title: "Traffic Accident Hotspot Detection",
    description:
      "Live ML system that clusters 1,498 real accident records using DBSCAN to identify 43 hotspots, with Random Forest risk prediction by time, weather, and road type.",
    tags: [
      "Postgres",
      "DBSCAN",
      "OpenStreetMap",
      "Django",
      "scikit-learn",
      "Open-Meteo",
      "Leaflet.js",
      "Chart.js",
    ],
    type: "Academic project",
    year: "2026",
    link: "https://traffic-hotspot.onrender.com",
    image: "/images/traffic.png",
    live: true,
  },
  {
    title: "EduNest",
    description:
      "Private instructor-led LMS with token-based enrollment, role-based access control, and Google OAuth. Built for focused learning — no marketplace noise, no subscriptions.",
    tags: [
      "Laravel",
      "Repository Design Pattern",
      "Token-based Enrollment",
      "Google SSO",
    ],
    type: "Client project",
    year: "2026",
    link: "https://lms.recc.com.np",
    image: "/images/lms.png",
    live: true,
  },
  {
    title: "DwellCasa",
    description:
      "Hotel management platform for a boutique property in Lalitpur. Built with repository pattern for clean architecture, covering listings, bookings, and a full admin panel.",
    tags: [
      "Laravel",
      "Inventory",
      "Role-Based Access Control",
      "Multi-Location Support",
      "Google SSO"
    ],
    type: "Client project",
    year: "2026",
    link: "https://dwellcasanepal.com",
    image: "/images/dwellcasa.png",
    live: true,
  },
  {
    title: "MotoVault",
    description:
      "Semantic product recommendation engine using SBERT embeddings and cosine similarity to surface relevant bikes based on natural language queries — not just keyword matching.",
    tags: ["Cosine-Similarity", "SBERT", "Python", "all-MiniLM-L6-v2"],
    type: "Academic project",
    year: "2024",
    link: "https://github.com/chris-bhaila/E-commerce-website-with-Product-Recommendation",
    image: "/images/motovault.png",
    live: false,
  },
];

const tagStyles: Record<string, string> = {
  // AI/ML Tools — blue
  Python: "text-[#3B82F6] border-[#3B82F6]/30 bg-[#3B82F6]/[0.06]",
  PyTorch: "text-[#3B82F6] border-[#3B82F6]/30 bg-[#3B82F6]/[0.06]",
  "scikit-learn": "text-[#3B82F6] border-[#3B82F6]/30 bg-[#3B82F6]/[0.06]",
  SBERT: "text-[#3B82F6] border-[#3B82F6]/30 bg-[#3B82F6]/[0.06]",
  Django: "text-[#3B82F6] border-[#3B82F6]/30 bg-[#3B82F6]/[0.06]",
  "all-MiniLM-L6-v2": "text-[#3B82F6] border-[#3B82F6]/30 bg-[#3B82F6]/[0.06]",
  Postgres: "text-[#3B82F6] border-[#3B82F6]/30 bg-[#3B82F6]/[0.06]",

  // Algorithms — purple
  DBSCAN: "text-accent border-accent/30 bg-accent/[0.06]",
  "Random Forest": "text-accent border-accent/30 bg-accent/[0.06]",
  "k-nearest neighbors": "text-accent border-accent/30 bg-accent/[0.06]",
  "Cosine-Similarity": "text-accent border-accent/30 bg-accent/[0.06]",
  "Decision Tree": "text-accent border-accent/30 bg-accent/[0.06]",
  ID3: "text-accent border-accent/30 bg-accent/[0.06]",
  CNN: "text-accent border-accent/30 bg-accent/[0.06]",
  "AI/ML": "text-accent border-accent/30 bg-accent/[0.06]",

  // Web / Architecture — green
  Laravel: "text-[#1D9E75] border-[#1D9E75]/30 bg-[#1D9E75]/[0.06]",
  "Repository Design Pattern":
    "text-[#1D9E75] border-[#1D9E75]/30 bg-[#1D9E75]/[0.06]",
  "Token-based Enrollment":
    "text-[#1D9E75] border-[#1D9E75]/30 bg-[#1D9E75]/[0.06]",
  "Role-Based Access Control":
    "text-[#1D9E75] border-[#1D9E75]/30 bg-[#1D9E75]/[0.06]",
  "Multi-Location Support":
    "text-[#1D9E75] border-[#1D9E75]/30 bg-[#1D9E75]/[0.06]",
  Inventory: "text-[#1D9E75] border-[#1D9E75]/30 bg-[#1D9E75]/[0.06]",
  Web: "text-[#1D9E75] border-[#1D9E75]/30 bg-[#1D9E75]/[0.06]",
  Live: "text-[#1D9E75] border-[#1D9E75]/30 bg-[#1D9E75]/[0.06]",

  // Third-party — amber
  "Google SSO": "text-[#D97706] border-[#D97706]/30 bg-[#D97706]/[0.06]",
  "Google OAuth": "text-[#D97706] border-[#D97706]/30 bg-[#D97706]/[0.06]",
  "Open-Meteo": "text-[#D97706] border-[#D97706]/30 bg-[#D97706]/[0.06]",
  "Leaflet.js": "text-[#D97706] border-[#D97706]/30 bg-[#D97706]/[0.06]",
  OpenStreetMap: "text-[#D97706] border-[#D97706]/30 bg-[#D97706]/[0.06]",
  "Chart.js": "text-[#D97706] border-[#D97706]/30 bg-[#D97706]/[0.06]",
};
---

<section id="work" class="bg-cream px-8 pb-24">
  <div class="max-w-6xl mx-auto">
    <div
      class="flex items-baseline justify-between border-b border-cream-border pb-5 mb-8 reveal"
    >
      <h2 class="font-serif text-2xl text-ink">Selected work</h2>
      <span class="font-mono text-[11px] text-muted"
        >0{projects.length} projects</span
      >
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        projects.map((project) => (
          <a
            href={project.link}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-white border border-cream-border rounded-2xl overflow-hidden flex flex-col reveal group"
          >
            <div class="overflow-hidden bg-cream-border h-48">
              <img
                src={project.image}
                alt={project.title}
                class="w-full h-full object-cover object-top group-hover:scale-[1.03] transition-transform duration-500"
              />
            </div>

            <div class="p-6 flex flex-col flex-1">
              <div class="flex flex-wrap gap-1.5 mb-3">
                {project.tags.map((tag) => (
                  <span
                    class={`font-mono text-[10px] px-2.5 py-1 rounded-full border ${tagStyles[tag] ?? "text-muted border-cream-border"}`}
                  >
                    {tag}
                  </span>
                ))}
              </div>
              <h3 class="font-serif text-xl text-ink mb-2">{project.title}</h3>
              <p class="text-muted text-sm leading-relaxed mb-5 flex-1">
                {project.description}
              </p>
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                  {project.live && (
                    <span class="flex items-center gap-1.5 bg-[#1D9E75]/10 border border-[#1D9E75]/30 rounded-full px-2.5 py-1">
                      <span class="relative flex h-1.5 w-1.5">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#1D9E75] opacity-75" />
                        <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-[#1D9E75]" />
                      </span>
                      <span class="font-mono text-[10px] text-[#1D9E75]">
                        live
                      </span>
                    </span>
                  )}
                  <span class="font-mono text-[10px] text-muted/60 uppercase tracking-wide">
                    {project.type} · {project.year}
                  </span>
                </div>
                <span class="w-7 h-7 rounded-full border border-cream-border flex items-center justify-center text-ink group-hover:bg-ink group-hover:text-white transition-colors duration-200">
                  →
                </span>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
