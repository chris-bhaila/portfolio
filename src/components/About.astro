---

---

<section id="about" class="bg-cream px-8 py-20">
    <div class="max-w-6xl mx-auto">
        <div
            class="flex items-baseline justify-between border-b border-cream-border pb-5 mb-12 reveal"
        >
            <h2 class="font-serif text-2xl text-ink">About</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-[70%_30%] gap-8 items-start">
            <!-- Text -->
            <div class="reveal">
                <p
                    class="font-mono text-[11px] text-muted tracking-[0.1em] uppercase mb-5"
                >
                    — Chris Bhaila
                </p>
                <p
                    class="font-serif text-[clamp(1.4rem,2.5vw,2rem)] leading-[1.15] tracking-[-0.02em] text-ink mb-6"
                >
                    A developer who builds things that<br />
                    <em class="text-accent">think, look good, and ship.</em>
                </p>
                <p class="text-muted text-[15px] leading-relaxed mb-6">
                    I'm a final year BCA student at Thames International
                    College, Kathmandu, focused on building intelligent web
                    products. I work across the full stack, from training ML
                    models to deploying polished interfaces with a particular
                    interest in making AI actually useful to real people.
                </p>
                <p
                    class="text-muted text-[15px] leading-relaxed mb-10"
                >
                    When I'm not building, I'm obsessing over UI details,
                    exploring new ML techniques, or figuring out how to make
                    something faster and cleaner than it was yesterday.
                </p>

                <div class="flex flex-wrap gap-3">
                    <a
                        href="/files/Chris_Bhaila_Resume.pdf"
                        target="_blank"
                        class="flex items-center gap-2 bg-ink text-white text-xs font-mono px-5
                    py-2.5 rounded-full hover:bg-ink/80 transition-colors
                    duration-200"
                    >
                        <svg
                            class="w-3.5 h-3.5"
                            viewBox="0 0 24 24"
                            fill="currentColor"
                            ><path
                                d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8l-6-6zm-1 1.5L18.5 9H13V3.5zM6 20V4h5v7h7v9H6z"
                            ></path></svg
                        >
                        Download CV
                    </a>

                    <a
                        href="#contact"
                        class="flex items-center gap-2 border
                border-cream-border text-ink text-xs font-mono px-5 py-2.5
                rounded-full hover:bg-ink hover:text-white transition-colors
                duration-200"
                    >
                        Open to work
                        <span class="relative flex h-1.5 w-1.5">
                            <span
                                class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#1D9E75] opacity-75"
                            ></span>
                            <span
                                class="relative inline-flex rounded-full h-1.5 w-1.5 bg-[#1D9E75]"
                            ></span>
                        </span>
                    </a>
                </div>
            </div>

            <!-- Photo -->
            <div class="reveal flex justify-center md:justify-end">
                <div
                    class="w-80 h-80 rounded-full overflow-hidden border-4 border-cream-border"
                >
                    <img
                        src="/images/chris.png"
                        alt="Chris Bhaila"
                        class="w-full h-full object-cover"
                    />
                </div>
            </div>
        </div>
    </div>
</section>
