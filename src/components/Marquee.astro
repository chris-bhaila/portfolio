---
const stack = [
  'Python', 'Laravel', 'SBERT', 'DBSCAN',
  'Random Forest', 'scikit-learn', 'PHP',
  'Tailwind CSS', 'MySQL', 'Astro',
  'Cosine Similarity', 'Decision Tree', 'REST APIs',
  // duplicated for seamless loop
  'Python', 'Laravel', 'SBERT', 'DBSCAN',
  'Random Forest', 'scikit-learn', 'PHP',
  'Tailwind CSS', 'MySQL', 'Astro',
  'Cosine Similarity', 'Decision Tree', 'REST APIs',
]
---

<div class="bg-dark border-t border-white/[0.06] py-3.5 overflow-hidden">
  <div class="marquee-track">
    {stack.map(item => (
      <span class="font-mono text-[11px] text-white/20 tracking-[0.08em] whitespace-nowrap flex-shrink-0">
        {item} <span class="text-white/10 mx-3">/</span>
      </span>
    ))}
  </div>
</div>