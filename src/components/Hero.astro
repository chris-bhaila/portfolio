---
const stack = [
  'Python', 'Laravel', 'SBERT', 'DBSCAN',
  'Random Forest', 'scikit-learn', 'PHP',
  'Tailwind CSS', 'MySQL', 'Astro',
  'Cosine Similarity', 'Decision Tree', 'REST APIs',
  'Postgres', 'Render', 'Vercel', 'GitHub', 'NLP', 'LLMs',
  'Python', 'Laravel', 'SBERT', 'DBSCAN',
  'Random Forest', 'scikit-learn', 'PHP',
  'Tailwind CSS', 'MySQL', 'Astro',
  'Cosine Similarity', 'Decision Tree', 'REST APIs',
  'Postgres', 'Render', 'Vercel', 'GitHub', 'NLP', 'LLMs',
]
---

<section class="bg-dark min-h-[calc(100dvh-3.6rem)] flex flex-col">

  <!-- Center content takes all available space -->
  <div class="flex-1 flex flex-col items-center justify-center text-center px-6 sm:px-8 py-12">

    <!-- Eyebrow -->
    <div class="flex flex-col sm:flex-row items-center gap-2 sm:gap-3 mb-7">
      <div class="flex items-center gap-3">
        <span class="w-6 h-px bg-accent hidden sm:inline-block"></span>
        <p class="font-mono text-[10.5px] tracking-[0.14em] uppercase text-white/30">
          Web Dev · AI/ML Engineer
        </p>
      </div>
      <span class="w-1.5 h-1.5 rounded-full bg-white/10 hidden sm:inline-block"></span>
      <span class="font-mono text-[10.5px] tracking-[0.1em] text-accent flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-accent inline-block"></span>
        Open to work
      </span>
    </div>

    <!-- Name -->
    <h1 class="font-serif text-[clamp(2.8rem,9vw,7rem)] leading-none tracking-[-0.03em] text-white/90 mb-5">
      Chris Bhaila<span class="text-accent">.</span>
    </h1>

    <!-- Description -->
    <p class="text-[13px] text-white/30 leading-relaxed max-w-sm mb-8">
      Building <span class="text-white/55 font-medium">intelligent web products</span> — from
      trained models to deployed interfaces. Based in Kathmandu.
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row items-center gap-3">
      <a
        href="#work"
        class="font-mono text-[11.5px] font-medium tracking-[0.06em] uppercase bg-accent text-dark px-6 py-2.5 hover:opacity-85 transition-opacity duration-150"
      >
        View my work
      </a>
      <a
        href="#contact"
        class="font-mono text-[11.5px] tracking-[0.06em] uppercase text-white/30 border border-white/10 px-6 py-2.5 hover:text-white/60 hover:border-white/25 transition-colors duration-150"
      >
        Get in touch
      </a>
    </div>

  </div>

</section>