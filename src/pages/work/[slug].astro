---
import { projects } from '../../data/projects.ts'
import type { Project } from '../../data/projects.ts'
import Layout from '../../layouts/Layout.astro'
import Nav from '../../components/Nav.astro'
import WorkHero from '../../components/work/WorkHero.astro'
import WorkGallery from '../../components/work/WorkGallery.astro'
import WorkOverview from '../../components/work/WorkOverview.astro'
import WorkCallout from '../../components/work/WorkCallout.astro'
import WorkStack from '../../components/work/WorkStack.astro'
import WorkDetailGallery from '../../components/work/WorkDetailGallery.astro'
import WorkImpact from '../../components/work/WorkImpact.astro'
import WorkNextProject from '../../components/work/WorkNextProject.astro'

export async function getStaticPaths() {
  return projects.map((project: typeof projects[number], i: number) => ({
    params: { slug: project.slug },
    props: { project, nextProject: projects[(i + 1) % projects.length] },
  }))
}

const { project, nextProject } = Astro.props as { project: Project; nextProject: Project }
---

<Layout title={`${project.title} — Chris Bhaila`}>
  <Nav />
  <WorkHero project={project} />
  <WorkGallery project={project} />
  <WorkOverview project={project} />
  <WorkCallout project={project} />
  <WorkStack project={project} />
  <WorkDetailGallery project={project} />
  <WorkImpact project={project} />
  <WorkNextProject project={nextProject} />
</Layout>